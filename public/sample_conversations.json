      "b63f72dd5e369cd576a1f36b61704289": {
        "id": "b63f72dd5e369cd576a1f36b61704289",
        "message": {
          "id": "5c3418b8251b77dc78912e2698bd3e7d",
          "author": {
            "role": "system",
